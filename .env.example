# Required
GEMINI_API_KEY=your-api-key

# Optional (defaults shown)
CORTEXRAG_PORT=8080
CORTEXRAG_VECTOR_BACKEND=memory
CORTEXRAG_EMBEDDING_PROVIDER=gemini
CORTEXRAG_EMBEDDING_MODEL=gemini-embedding-001
CORTEXRAG_LLM_PROVIDER=gemini
CORTEXRAG_LLM_MODEL=gemini-3.5-flash-lite
CORTEXRAG_CHUNK_SIZE=512
CORTEXRAG_CHUNK_OVERLAP=64
CORTEXRAG_CACHE_SIZE=10000
CORTEXRAG_TOP_K=5
CORTEXRAG_WORKER_COUNT=0

# pgvector (if VECTOR_BACKEND=pgvector)
POSTGRES_URL=postgres://user:pass@localhost:5432/cortexrag

# Ollama (if using ollama providers)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2
